{
  "name": "memran/marwa-kafka",
  "description": "A lightweight, secure Kafka producer/consumer wrapper with Envelop messaging support",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Mohammad Emran",
      "email": "memran.dhk@gmail.com"
    }
  ],
  "require": {
    "php": "^8.1 || ^8.2 || ^8.3",
    "ext-rdkafka": "*",
    "memran/marwa-envelop": "^1.0",
    "psr/log": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "Marwa\\Kafka\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Marwa\\Kafka\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.76",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.0"
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist --testsuite unit",
    "test:integration": "phpunit --configuration phpunit.xml.dist --testsuite integration",
    "test:coverage": "phpunit --configuration phpunit.xml.dist --testsuite unit --coverage-text",
    "analyse": "phpstan analyse --configuration phpstan.neon.dist --no-progress --debug",
    "lint": "php-cs-fixer fix --dry-run --diff --verbose --sequential --allow-unsupported-php-version=yes",
    "fix": "php-cs-fixer fix --verbose --sequential --allow-unsupported-php-version=yes",
    "ci": [
      "@test",
      "@analyse",
      "@lint"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
